        <mxCell id="uDALRvVdZjiVUl6onfUO-10" parent="1" style="whiteSpace=wrap;html=1;aspect=fixed;" value="Technology (Tools)" vertex="1">
          <mxGeometry height="120" width="120" x="90" y="40" as="geometry" />
        </mxCell>
        <mxCell id="uDALRvVdZjiVUl6onfUO-11" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ol&gt;&lt;li&gt;Language barriers (English vs. local Yoruba dialects).&lt;/li&gt;&lt;li&gt;Mutual mistrust between students and local landlords/indigenes.&lt;/li&gt;&lt;li&gt;Fear of retaliation (users afraid to report without guaranteed anonymity).&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="130" width="250" x="530" y="35" as="geometry" />
        </mxCell>
        <mxCell id="uDALRvVdZjiVUl6onfUO-12" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ol&gt;&lt;li&gt;No centralized or unified reporting channel.&lt;/li&gt;&lt;li&gt;Unclear escalation matrix (Who handles what? SUG, Obas, School authorities or Police?).&lt;/li&gt;&lt;li&gt;Lack of feedback mechanisms (reporters never know if their issue was addressed).&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="540" y="400" as="geometry" />
        </mxCell>
        <mxCell id="uDALRvVdZjiVUl6onfUO-14" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ol&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;Poor power supply making smartphone access inconsistent.&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Sporadic internet connectivity in specific areas like Etioro and Iwaro.&lt;/li&gt;&lt;li&gt;Physical distance between reporting authorities (Campus vs. remote towns).&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="-170" y="385" as="geometry" />
        </mxCell>
        <mxCell id="uDALRvVdZjiVUl6onfUO-15" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;ol&gt;&lt;li&gt;Over-reliance on fragmented WhatsApp groups.&lt;/li&gt;&lt;li&gt;Lack of a structured data-capture system for complaints.&lt;/li&gt;&lt;li&gt;Complex interfaces alienating older indigenes.&lt;/li&gt;&lt;/ol&gt;" vertex="1">
          <mxGeometry height="150" width="250" x="-170" y="10" as="geometry" />
        </mxCell>
